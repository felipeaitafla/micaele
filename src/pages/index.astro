---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import Services from '../components/Services.astro';
import SpecialServices from '../components/SpecialServices.astro';
import Procedures from '../components/Procedures.astro';
import Portfolio from '../components/Portfolio.astro';
import About from '../components/About.astro';
import Space from '../components/Space.astro';
import Contact from '../components/Contact.astro';
import Location from '../components/Location.astro';
---

<Layout
	title="Micaele Spa Estética – Clínica e SPA de Massagem em Goiânia"
	description="Micaele Spa Estética - Massoterapeuta em Goiânia especialista em Massagem Terapêutica, Relaxante, Muscular, Pedras Quentes, Liberação Miofascial, Drenagem Linfática, Ventosaterapia, Limpeza Pele, Microagulhamento, Dermaplaning, Banho de Lua, Depilação na Máquina. Estamos no Jardim América e atendemos Homens e Mulheres"
	keywords="massagem goiania, massoterapeuta jardim america, clinica de estética, massagem relaxante, massagista"
>
	<main>
		<Hero />
		<Testimonials />
		<Services />
		<SpecialServices />
		<Procedures />
		<Portfolio />
		<About />
		<Space />
		<Contact />
		<Location />
	</main>
</Layout>

<style>
	main {
		width: 100%;
	}
</style>
