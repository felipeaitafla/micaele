---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  align?: 'center' | 'left';
  split?: boolean;
  equalColumns?: boolean;
}
const { title, subtitle, description, align = 'center', split = false, equalColumns = false } = Astro.props;
---

{split ? (
  <header class:list={['section-header', 'section-header--split', equalColumns && 'section-header--equal']}>
    <div class="section-header__col section-header__col--title">
      <div class="section-header__ornament" aria-hidden="true">
        <span class="section-header__rule"></span>
        <span class="section-header__diamond">&#9670;</span>
        <span class="section-header__rule"></span>
      </div>
      <h2 class="section-header__title">{title}</h2>
      {subtitle && <p class="section-header__subtitle">{subtitle}</p>}
    </div>

    <div class="section-header__col section-header__col--desc">
      {description && <p class="section-header__desc">{description}</p>}
    </div>
  </header>
) : (
  <header class:list={['section-header', align === 'left' && 'section-header--left']}>
    <div class="section-header__ornament" aria-hidden="true">
      <span class="section-header__rule"></span>
      <span class="section-header__diamond">&#9670;</span>
      <span class="section-header__rule"></span>
    </div>

    <h2 class="section-header__title">{title}</h2>
    {subtitle && <p class="section-header__subtitle">{subtitle}</p>}
    {description && <p class="section-header__desc">{description}</p>}
  </header>
)}

<style>
  .section-header {
    text-align: center;
    max-width: 52rem;
    margin: 0 auto 3.5rem;
  }

  .section-header__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-bottom: 1.75rem;
  }
  .section-header__rule {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold-primary));
  }
  .section-header__rule:last-child {
    background: linear-gradient(90deg, var(--color-gold-primary), transparent);
  }
  .section-header__diamond {
    color: var(--color-gold-primary);
    font-size: 0.55rem;
    line-height: 1;
  }

  .section-header__title {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.2;
    margin-bottom: 0.75rem;
    text-wrap: balance;
  }

  .section-header__subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--color-gold-primary);
    margin-bottom: 1.25rem;
  }

  .section-header__desc {
    color: var(--color-text-body);
    max-width: 46rem;
    margin: 0 auto;
  }

  /* Variante split: título e descrição em colunas lado a lado */
  .section-header--split {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    max-width: none;
    text-align: left;
    margin: 0 auto 3.5rem;
  }
  .section-header--split .section-header__ornament {
    justify-content: flex-start;
    margin-bottom: 1.25rem;
  }
  .section-header--split .section-header__title {
    font-size: 40px;
    margin-bottom: 0;
    text-transform: capitalize;
  }
  .section-header--split .section-header__col--title {
    flex: 0 0 auto;
    max-width: 34rem;
  }
  .section-header--split .section-header__col--desc {
    flex: 1;
    max-width: 34rem;
  }
  .section-header--split .section-header__subtitle {
    font-size: 24px;
    line-height: 1.1;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }
  .section-header--split .section-header__desc {
    max-width: none;
    margin: 0;
    font-size: 15px;
    text-align: justify;
  }

  /* Variante split com colunas de largura igual (1fr 1fr) */
  .section-header--split.section-header--equal .section-header__col--title,
  .section-header--split.section-header--equal .section-header__col--desc {
    flex: 1 1 0;
    min-width: 0;
    max-width: none;
  }

  @media (max-width: 720px) {
    .section-header--split {
      flex-direction: column;
      gap: 1.5rem;
    }
    .section-header--split .section-header__col--title,
    .section-header--split .section-header__col--desc {
      max-width: none;
    }
    .section-header--split .section-header__col--title {
      text-align: center;
    }
    .section-header--split .section-header__ornament {
      justify-content: center;
    }
  }

  /* Variante alinhada à esquerda: mesmo ornamento duplo, só que à esquerda */
  .section-header--left {
    text-align: left;
    margin-inline: 0;
  }
  .section-header--left .section-header__ornament {
    justify-content: flex-start;
  }
  .section-header--left .section-header__desc {
    margin-inline: 0;
  }
</style>
