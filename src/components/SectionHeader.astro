---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  align?: 'center' | 'left';
}
const { title, subtitle, description, align = 'center' } = Astro.props;
---

<header class:list={['section-header', align === 'left' && 'section-header--left']}>
  <div class="section-header__ornament" aria-hidden="true">
    <span class="section-header__rule"></span>
    <span class="section-header__diamond">&#9670;</span>
    <span class="section-header__rule"></span>
  </div>

  <h2 class="section-header__title">{title}</h2>
  {subtitle && <p class="section-header__subtitle">{subtitle}</p>}
  {description && <p class="section-header__desc">{description}</p>}
</header>

<style>
  .section-header {
    text-align: center;
    max-width: 52rem;
    margin: 0 auto 3.5rem;
  }

  .section-header__ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-bottom: 1.75rem;
  }
  .section-header__rule {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold-primary));
  }
  .section-header__rule:last-child {
    background: linear-gradient(90deg, var(--color-gold-primary), transparent);
  }
  .section-header__diamond {
    color: var(--color-gold-primary);
    font-size: 0.55rem;
    line-height: 1;
  }

  .section-header__title {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.2;
    margin-bottom: 0.75rem;
    text-wrap: balance;
  }

  .section-header__subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--color-gold-primary);
    margin-bottom: 1.25rem;
  }

  .section-header__desc {
    color: var(--color-text-body);
    max-width: 46rem;
    margin: 0 auto;
  }

  /* Variante alinhada à esquerda */
  .section-header--left {
    text-align: left;
    margin-inline: 0;
  }
  .section-header--left .section-header__ornament {
    justify-content: flex-start;
  }
  .section-header--left .section-header__rule:first-child {
    width: 40px;
    background: var(--color-gold-primary);
  }
  .section-header--left .section-header__rule:last-child {
    display: none;
  }
  .section-header--left .section-header__desc {
    margin-inline: 0;
  }
</style>
