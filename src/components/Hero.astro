---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import donos from '../assets/donos/donos-ajustada.png';
import fundo from '../assets/empresa/espaco-6.jpg';
import { sanityFetch, urlFor, whatsappUrl } from '../lib/sanity';
import { home, settings } from '../lib/content';

const data = await sanityFetch<any>(
  `*[_type == "homePage"][0]{ heroTitle, heroDescription, heroLocation, heroImage, heroBackgroundImage }`
);
const cfg = await sanityFetch<any>(
  `*[_type == "siteSettings"][0]{ companyName, phone, phoneDisplay }`
);

const title = data?.heroTitle ?? home.heroTitle;
const description = data?.heroDescription ?? home.heroDescription;
const location = data?.heroLocation ?? home.heroLocation;

const companyName = cfg?.companyName ?? settings.companyName;
const phone = cfg?.phone ?? settings.phone;
const phoneDisplay = cfg?.phoneDisplay ?? settings.phoneDisplay;

const waUrl = whatsappUrl(phone, companyName);
const telUrl = `tel:+${phone}`;

// Imagens do Sanity têm prioridade; senão usa os arquivos locais.
const ownersSrc = urlFor(data?.heroImage)?.width(900).url();
const bgSrc = urlFor(data?.heroBackgroundImage)?.width(1800).url();
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    {bgSrc
      ? <img src={bgSrc} alt="" loading="eager" />
      : <Image src={fundo} alt="" widths={[900, 1400, 1800]} sizes="100vw" loading="eager" />}
  </div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <Image src={logo} alt={companyName} class="hero__logo" widths={[260, 520]} loading="eager" />

      <h1 class="hero__title">{title}</h1>

      <p class="hero__desc">{description}</p>

      {location && (
        <p class="hero__location">
          <span class="hero__diamond" aria-hidden="true">&#9670;</span>
          {location}
        </p>
      )}

      <div class="hero__actions">
        <a href={waUrl} class="btn btn--primary hero__btn" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="hero__icon">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.548 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          WhatsApp
        </a>
        <a href={telUrl} class="btn btn--outline hero__btn" aria-label={`Ligar para ${phoneDisplay}`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="hero__icon">
            <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a.99.99 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2Z"/>
          </svg>
          Ligação
        </a>
      </div>
    </div>

    <div class="hero__figure">
      <span class="hero__glow" aria-hidden="true"></span>
      {ownersSrc
        ? <img src={ownersSrc} alt={`Proprietários da ${companyName}`} class="hero__owners" loading="eager" />
        : <Image
            src={donos}
            alt={`Proprietários da ${companyName}`}
            class="hero__owners"
            widths={[420, 525]}
            sizes="(max-width: 900px) 70vw, 40vw"
            loading="eager"
          />}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 2rem 0 0;
    min-height: 100svh;
    display: grid;
    align-items: center;
  }

  /* --- Fundo: foto do espaço, escurecida e aquecida para não brigar com o dourado --- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Neutraliza o LED azul/roxo do ambiente e integra a foto à paleta */
    filter: saturate(0.35) sepia(0.35) brightness(0.42) contrast(1.05);
  }

  /* Véu: escurece o suficiente para o texto manter contraste AAA + vinheta de vela */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        ellipse 70% 55% at 62% 42%,
        rgba(199, 163, 68, 0.16) 0%,
        transparent 70%
      ),
      linear-gradient(
        100deg,
        var(--color-bg-base) 0%,
        rgba(20, 18, 15, 0.94) 38%,
        rgba(20, 18, 15, 0.74) 68%,
        rgba(20, 18, 15, 0.88) 100%
      );
  }

  /* Texto e imagem com metade da largura cada */
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
    width: 100%;
  }

  /* --- Coluna de texto --- */
  .hero__content {
    padding: 2rem 0 3rem;
  }

  .hero__logo {
    width: clamp(170px, 17vw, 230px);
    height: auto;
    margin-bottom: 1.75rem;
  }

  .hero__title {
    /* 36px no desktop; encolhe em telas estreitas para não quebrar o layout */
    font-size: clamp(1.5rem, 2.8vw, 36px);
    line-height: 1.2;
    letter-spacing: 0.01em;
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .hero__desc {
    font-size: 15px;
    color: var(--color-text-body);
    margin-bottom: 1.5rem;
  }

  .hero__location {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-gold-bright);
    margin-bottom: 1.75rem;
  }
  .hero__diamond {
    color: var(--color-gold-primary);
    font-size: 0.6rem;
    line-height: 1;
  }

  /* Os dois botões sempre lado a lado */
  .hero__actions {
    display: flex;
    gap: 1rem;
  }
  .hero__btn {
    gap: 0.55rem;
  }
  .hero__icon {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }

  /* --- Coluna da foto: recorte dos proprietários sob luz dourada --- */
  .hero__figure {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    align-self: end;
  }

  /* A "luz de palco" dourada que nasce atrás do recorte */
  .hero__glow {
    position: absolute;
    bottom: 4%;
    left: 50%;
    translate: -50% 0;
    width: 105%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(232, 206, 125, 0.3) 0%,
      rgba(199, 163, 68, 0.16) 34%,
      rgba(199, 163, 68, 0.05) 55%,
      transparent 72%
    );
    z-index: -1;
    pointer-events: none;
  }

  .hero__owners {
    width: 100%;
    max-width: 32rem;
    height: auto;
    display: block;
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.55));
    /* O recorte termina reto na altura da coxa; dissolver a base evita a
       linha de corte e integra a figura ao escuro do fundo. */
    mask-image: linear-gradient(to bottom, #000 78%, transparent 99%);
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 99%);
  }

  /* --- Entrada suave, no ritmo do design system --- */
  .hero__content > *,
  .hero__figure {
    animation: hero-rise 1.2s cubic-bezier(0.22, 0.61, 0.36, 1) backwards;
  }
  .hero__logo { animation-delay: 0.1s; }
  .hero__title { animation-delay: 0.25s; }
  .hero__desc { animation-delay: 0.4s; }
  .hero__location { animation-delay: 0.5s; }
  .hero__actions { animation-delay: 0.6s; }
  .hero__figure { animation-delay: 0.35s; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  /* --- Responsivo --- */
  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-top: 2rem;
      align-items: stretch;
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .hero__content {
      padding: 2rem 0 2.5rem;
      text-align: center;
    }
    .hero__logo { margin-inline: auto; }
    .hero__location { justify-content: center; }
    .hero__actions { justify-content: center; }
    .hero__figure { order: 2; }
    .hero__owners { max-width: 22rem; }
  }

  @media (max-width: 480px) {
    .hero__actions .btn { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content > *,
    .hero__figure {
      animation: none;
    }
  }
</style>
