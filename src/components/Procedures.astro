---
import SectionHeader from './SectionHeader.astro';
import ServiceCard from './ServiceCard.astro';
import { sanityFetch, urlFor } from '../lib/sanity';
import { home, settings } from '../lib/content';

const data = await sanityFetch<any>(
  `*[_type == "homePage"][0]{ proceduresTitle, proceduresDescription, procedures }`
);
const cfg = await sanityFetch<any>(
  `*[_type == "siteSettings"][0]{ companyName, phone }`
);

const title = data?.proceduresTitle ?? home.proceduresTitle;
const description = data?.proceduresDescription ?? home.proceduresDescription;
const procedures = data?.procedures?.length ? data.procedures : home.procedures;

const companyName = cfg?.companyName ?? settings.companyName;
const phone = cfg?.phone ?? settings.phone;

// Fotos locais indexadas por slug: src/assets/servicos/<slug>.jpg
const files = import.meta.glob<ImageMetadata>('../assets/servicos/*.jpg', {
  eager: true,
  import: 'default',
});
const bySlug = Object.fromEntries(
  Object.entries(files).map(([p, img]) => [p.split('/').pop()!.replace('.jpg', ''), img])
);
---

<section class="procedures section-padding" id="procedimentos">
  <div class="container">
    <SectionHeader title={title} description={description} />

    <ul class="service-grid">
      {procedures.map((item: any) => (
        <ServiceCard
          name={item.name}
          image={urlFor(item.image)?.width(800).height(600).fit('crop').url() ?? null}
          imageFile={bySlug[item.slug] ?? null}
          phone={phone}
          companyName={companyName}
        />
      ))}
    </ul>
  </div>
</section>
