---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { sanityFetch, whatsappUrl } from '../lib/sanity';
import { settings as fallback } from '../lib/content';

const cfg = await sanityFetch<any>(`*[_type == "siteSettings"][0]`);
const s = { ...fallback, ...(cfg ?? {}) };

const year = new Date().getFullYear();

// phone2 é só dígitos formatados (sem DDI); os outros links já usam o padrão E.164.
const phone2Tel = s.phone2 ? `tel:+55${s.phone2.replace(/\D/g, '')}` : null;

const socials = [
  { url: s.instagram, label: 'Instagram' },
  { url: s.facebook, label: 'Facebook' },
  { url: s.youtube, label: 'YouTube' },
].filter((item) => Boolean(item.url));
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__col footer__brand">
        <Image src={logo} alt={s.companyName} class="footer__logo" widths={[200, 400]} loading="lazy" />
        <address class="footer__text">{s.address}</address>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Horário de atendimento</h2>
        <p class="footer__text">{s.hours1}</p>
        <p class="footer__text">{s.hours2}</p>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Contato</h2>
        <ul class="footer__contact">
          <li>
            <a href={whatsappUrl(s.phone, s.companyName)} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="footer__icon">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.548 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
              </svg>
              {s.phoneDisplay}
            </a>
          </li>
          {phone2Tel && (
            <li>
              <a href={phone2Tel}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="footer__icon">
                  <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a.99.99 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.58a1 1 0 0 1-.25 1.01l-2.2 2.2Z"/>
                </svg>
                {s.phone2}
              </a>
            </li>
          )}
          <li>
            <a href={`mailto:${s.email}`}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="footer__icon">
                <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
                <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
              </svg>
              {s.email}
            </a>
          </li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Redes sociais</h2>
        <ul class="footer__socials">
          {socials.map((item) => (
            <li>
              <a href={item.url} target="_blank" rel="noopener noreferrer">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer__legal">
      <p>&copy; {year} — Direitos reservados{s.cnpj && ` — CNPJ ${s.cnpj}`}</p>
      <p><a href="/politica-de-privacidade">Política de Privacidade</a></p>
    </div>

    <div class="ornament-divider footer__divider" aria-hidden="true">&#9670;</div>

    <div class="footer__credit">
      <p>Site desenvolvido por <strong>JP Marketing Digital e Tráfego Pago</strong></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-base);
    border-top: 1px solid var(--color-hairline);
    /* Sem padding embaixo: o respiro final é o padding-block do crédito */
    padding: 4.5rem 0 0;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
  }

  .footer__logo {
    width: 170px;
    height: auto;
    margin-bottom: 1.25rem;
  }

  .footer__brand .footer__text {
    max-width: 16rem;
  }

  .footer__title {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold-primary);
    margin-bottom: 0.75rem;
  }
  .footer__text {
    color: var(--color-text-body);
    font-size: 0.9rem;
    font-style: normal;
    line-height: 1.7;
  }

  .footer a {
    color: var(--color-text-body);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .footer a:hover {
    color: var(--color-gold-bright);
  }

  .footer__contact {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.9rem;
  }
  .footer__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .footer__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--color-gold-primary);
  }

  .footer__socials {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
  }

  .footer__divider {
    margin: 1.75rem 0 0;
  }

  /* Copyright e política nos extremos opostos, na mesma linha de base */
  .footer__legal {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--color-text-body);
  }

  .footer__credit {
    padding-block: 12px;
    text-align: center;
    font-size: 0.82rem;
    color: var(--color-text-body);
  }
  .footer__credit strong {
    color: var(--color-gold-primary);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }
  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .footer__legal {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
  }
</style>
