---
import SectionHeader from './SectionHeader.astro';
import { sanityFetch } from '../lib/sanity';
import { home, settings } from '../lib/content';

const data = await sanityFetch<any>(
  `*[_type == "homePage"][0]{ locationTitle, locationText, mapEmbedUrl }`
);
const cfg = await sanityFetch<any>(`*[_type == "siteSettings"][0]{ address }`);

const title = data?.locationTitle ?? home.locationTitle;
const text = data?.locationText ?? home.locationText;
const mapUrl = data?.mapEmbedUrl ?? home.mapEmbedUrl;
const address = cfg?.address ?? settings.address;
---

<section class="location section-padding" id="localizacao">
  <div class="container">
    <SectionHeader title={title} description={text} />

    <p class="location__address">{address}</p>

    <div class="location__map">
      <iframe
        src={mapUrl}
        title="Mapa com a localização da Micaele Spa Estética"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location {
    background-color: var(--color-bg-surface);
    border-top: 1px solid var(--color-hairline);
  }

  .location__address {
    text-align: center;
    color: var(--color-gold-bright);
    font-size: 0.95rem;
    max-width: 34rem;
    margin: -2rem auto 2.5rem;
  }

  .location__map {
    position: relative;
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 0 60px var(--color-glow);
  }
  .location__map iframe {
    display: block;
    width: 100%;
    height: clamp(300px, 45vh, 460px);
    border: 0;
    /* Integra o mapa claro do Google ao ambiente escuro do site */
    filter: invert(0.9) hue-rotate(180deg) saturate(0.55) brightness(0.95) contrast(0.9);
  }
</style>
