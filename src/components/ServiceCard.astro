---
import { Image } from 'astro:assets';
import { whatsappUrl } from '../lib/sanity';

interface Props {
  name: string;
  /** URL vinda do Sanity (tem prioridade) */
  image?: string | null;
  /** Arquivo local em src/assets, otimizado pelo Astro */
  imageFile?: ImageMetadata | null;
  phone: string;
  companyName: string;
}
const { name, image, imageFile, phone, companyName } = Astro.props;
const waUrl = whatsappUrl(phone, companyName, name);
---

<li class="card">
  <div class="card__media">
    {image ? (
      <img src={image} alt={name} loading="lazy" decoding="async" />
    ) : imageFile ? (
      <Image
        src={imageFile}
        alt={name}
        widths={[400, 800]}
        sizes="(max-width: 560px) 90vw, (max-width: 900px) 45vw, 30vw"
        loading="lazy"
      />
    ) : (
      /* Sem foto cadastrada ainda: painel ornamental em vez de espaço vazio */
      <div class="card__placeholder" aria-hidden="true">
        <span class="card__ornament">
          <span class="card__rule"></span>
          <span class="card__diamond">&#9670;</span>
          <span class="card__rule"></span>
        </span>
      </div>
    )}
  </div>

  <h3 class="card__name">{name}</h3>

  <a href={waUrl} class="btn btn--primary card__cta" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="card__icon">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.548 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
    </svg>
    Fale conosco
  </a>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    padding: 0.5rem 0.5rem 1.5rem;
    text-align: center;
    transition: border-color 0.4s ease, box-shadow 0.4s ease, transform 0.4s ease;
  }
  .card:hover {
    border-color: var(--color-gold-primary);
    box-shadow: 0 18px 50px -18px rgba(0, 0, 0, 0.7), 0 0 40px var(--color-glow);
    transform: translateY(-4px);
  }

  /* Moldura dupla do design system aplicada à foto */
  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 2px;
    margin-bottom: 1.25rem;
  }
  .card__media::after {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(232, 206, 125, 0.35);
    pointer-events: none;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .card:hover .card__media :global(img) {
    transform: scale(1.04);
  }

  .card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse at 50% 40%, rgba(199, 163, 68, 0.1), transparent 70%),
      var(--color-bg-base);
  }
  .card__ornament {
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 0.55;
  }
  .card__rule {
    width: 42px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold-primary));
  }
  .card__rule:last-child {
    background: linear-gradient(90deg, var(--color-gold-primary), transparent);
  }
  .card__diamond {
    color: var(--color-gold-primary);
    font-size: 0.8rem;
    line-height: 1;
  }

  .card__name {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-heading);
    padding: 0 1rem;
    margin-bottom: 1.25rem;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-wrap: balance;
  }

  .card__cta {
    margin: 0 1rem;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    font-size: 0.75rem;
  }
  .card__icon {
    width: 1em;
    height: 1em;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .card__cta {
      width: calc(100% - 2rem);
    }
  }
</style>
