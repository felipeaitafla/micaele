---
import SectionHeader from './SectionHeader.astro';
import { sanityFetch } from '../lib/sanity';
import { home, settings } from '../lib/content';

const data = await sanityFetch<any>(
  `*[_type == "homePage"][0]{ reviewsTitle, testimonials }`
);
const cfg = await sanityFetch<any>(
  `*[_type == "siteSettings"][0]{ googleReviewsUrl }`
);

const title = data?.reviewsTitle ?? home.reviewsTitle;
const reviewsUrl = cfg?.googleReviewsUrl ?? settings.googleReviewsUrl;

/**
 * Textos reais das avaliações publicadas no Google. O Studio pode substituí-los,
 * mas nunca exibimos depoimento fictício aqui.
 */
const testimonials: { name?: string; time?: string; text?: string }[] =
  data?.testimonials?.length ? data.testimonials : home.testimonials;

/** Tons quentes da paleta; todos passam AA com o texto escuro por cima. */
const avatarTones = ['#C7A344', '#D4B45C', '#B98E4A', '#E8CE7D', '#A8813C'];
const toneFor = (name = '') =>
  avatarTones[[...name].reduce((acc, ch) => acc + ch.charCodeAt(0), 0) % avatarTones.length];
---

<section class="reviews section-padding" id="depoimentos">
  <div class="container">
    <SectionHeader title={title} description={home.reviewsDescription} />

    <ul class="reviews__list">
      {testimonials.map((t) => (
        <li class="surface-card reviews__card">
          <div class="reviews__head">
            <span class="reviews__avatar" style={`--tone:${toneFor(t.name)}`} aria-hidden="true">
              {(t.name ?? '?').trim().charAt(0).toUpperCase()}
            </span>
            <div class="reviews__meta">
              {t.name && <p class="reviews__name">{t.name}</p>}
              {t.time && <p class="reviews__time">{t.time}</p>}
            </div>
          </div>

          <p class="reviews__stars" role="img" aria-label="Avaliação 5 de 5">
            <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          </p>

          <p class="reviews__text">{t.text}</p>
        </li>
      ))}
    </ul>

    <div class="reviews__cta">
      <a href={reviewsUrl} class="btn btn--outline" target="_blank" rel="noopener noreferrer">
        Clique e comprove
      </a>
    </div>
  </div>
</section>

<style>
  .reviews__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
  }

  .reviews__card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .reviews__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .reviews__avatar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background-color: var(--tone);
    color: var(--color-bg-base);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1;
  }

  .reviews__name {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-text-heading);
  }

  .reviews__time {
    font-size: 0.8rem;
    color: var(--color-text-body);
    opacity: 0.75;
  }

  .reviews__stars {
    color: var(--color-gold-primary);
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    line-height: 1;
  }

  .reviews__text {
    color: var(--color-text-body);
    font-size: 0.95rem;
  }

  .reviews__cta {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }
</style>
