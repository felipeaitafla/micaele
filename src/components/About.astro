---
import { Image } from 'astro:assets';
import { PortableText } from 'astro-portabletext';
import SectionHeader from './SectionHeader.astro';
import ela from '../assets/donos/ela.jpg';
import ele from '../assets/donos/ele.jpg';
import { sanityFetch, urlFor, whatsappUrl } from '../lib/sanity';
import { home, settings } from '../lib/content';

const data = await sanityFetch<any>(
  `*[_type == "homePage"][0]{ aboutTitle, aboutText, heroImage }`
);
const cfg = await sanityFetch<any>(
  `*[_type == "siteSettings"][0]{ companyName, phone }`
);

const title = data?.aboutTitle ?? home.aboutTitle;
const companyName = cfg?.companyName ?? settings.companyName;
const phone = cfg?.phone ?? settings.phone;
const waUrl = whatsappUrl(phone, companyName);

const portrait = urlFor(data?.heroImage)?.width(800).url();
const hasRichText = Array.isArray(data?.aboutText) && data.aboutText.length > 0;
---

<section class="about section-padding" id="quem-somos">
  <div class="container about__inner">
    <div class="about__media">
      {portrait ? (
        <div class="about__frame">
          <img src={portrait} alt={`Equipe da ${companyName}`} loading="lazy" />
        </div>
      ) : (
        /* Os dois retratos se alternam a cada 2,5s. role/aria-label descrevem o
           conjunto para leitores de tela, por isso cada img fica com alt vazio. */
        <div
          class="about__frame about__frame--swap"
          role="img"
          aria-label={`Proprietários da ${companyName}`}
        >
          <Image
            src={ela}
            alt=""
            class="about__photo about__photo--a"
            widths={[400, 800]}
            sizes="(max-width: 900px) 60vw, 34vw"
            loading="lazy"
          />
          <Image
            src={ele}
            alt=""
            class="about__photo about__photo--b"
            widths={[400, 800]}
            sizes="(max-width: 900px) 60vw, 34vw"
            loading="lazy"
          />
        </div>
      )}
    </div>

    <div class="about__content">
      <SectionHeader title={title} align="left" />

      <div class="about__text">
        {hasRichText ? (
          <PortableText value={data.aboutText} />
        ) : (
          home.aboutParagraphs.map((p) => <p>{p}</p>)
        )}
      </div>

      <a href={waUrl} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
        Fale conosco
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    background-color: var(--color-bg-surface);
    border-block: 1px solid var(--color-hairline);
  }

  /* Sem descrição dentro do cabeçalho aqui: o espaçamento padrão de 3.5rem
     do SectionHeader fica grande demais só com o título */
  .about__content :global(.section-header) {
    margin-bottom: 0.75rem;
  }

  .about__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  /* Recorte dos proprietários sob a mesma luz dourada do hero */
  .about__media {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .about__frame {
    position: relative;
    width: 100%;
    max-width: 24rem;
  }
  .about__frame::before {
    content: "";
    position: absolute;
    inset: -6% -4% 6%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(232, 206, 125, 0.2) 0%,
      rgba(199, 163, 68, 0.1) 40%,
      transparent 70%
    );
    z-index: -1;
  }
  .about__frame :global(img) {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 20px 36px rgba(0, 0, 0, 0.5));
  }

  /* --- Alternância entre os dois retratos --- */
  /* Estes têm fundo sólido claro, então ganham a moldura dupla do design system
     em vez do recorte flutuante. */
  .about__frame--swap {
    aspect-ratio: 3 / 4;
    padding: 8px;
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    background-color: var(--color-bg-base);
    box-shadow: 0 0 60px var(--color-glow);
  }
  .about__frame--swap::after {
    content: "";
    position: absolute;
    inset: 6px;
    border: 1px solid var(--color-gold-primary);
    pointer-events: none;
    z-index: 2;
  }

  .about__frame--swap :global(.about__photo) {
    position: absolute;
    inset: 8px;
    width: calc(100% - 16px);
    height: calc(100% - 16px);
    object-fit: cover;
    object-position: center top;
    border-radius: 2px;
    filter: saturate(0.85) sepia(0.08);
  }

  /* A foto de baixo fica sempre opaca e só a de cima transiciona: se as duas
     variassem juntas, o fundo escuro vazaria no meio da virada. */
  .about__frame--swap :global(.about__photo--b) {
    animation: about-swap 5s ease-in-out infinite;
  }

  /* 2,5s em cada retrato, com dissolve curto de ~0,3s */
  @keyframes about-swap {
    0%, 47% { opacity: 0; }
    53%, 97% { opacity: 1; }
    100% { opacity: 0; }
  }

  /* Sem movimento: mostra só o primeiro retrato, fixo */
  @media (prefers-reduced-motion: reduce) {
    .about__frame--swap :global(.about__photo--b) {
      animation: none;
      opacity: 0;
    }
  }

  .about__text {
    margin-bottom: 2rem;
  }
  .about__text :global(p) {
    color: var(--color-text-body);
    margin-bottom: 1.25rem;
    text-align: justify;
  }
  .about__text :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .about__inner {
      grid-template-columns: 1fr;
    }
    .about__media {
      order: 2;
    }
    .about__frame {
      max-width: 18rem;
    }

    /* Título e ornamento centralizados no mobile */
    .about :global(.section-header--left) {
      text-align: center;
      margin-inline: auto;
    }
    .about :global(.section-header--left .section-header__ornament) {
      justify-content: center;
    }

    .about__content > .btn {
      width: 100%;
    }
  }
</style>
